{
  "name": "@chieeeeno/claude-statusline",
  "version": "1.1.0",
  "description": "A fast, dependency-free status line for Claude Code. Shows context, rate limits, and cost. Renders in Python - no Node at render time.",
  "bin": { "claude-statusline": "bin/claude-statusline.js" },
  "files": ["bin/", "statusline.py", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "os": ["darwin", "linux"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chieeeeno/claude-statusline.git"
  },
  "keywords": ["claude", "claude-code", "statusline", "cli", "anthropic"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "test": "npm run test:py && npm run test:js",
    "test:py": "python3 tests/run_suite.py",
    "test:js": "node tests/run_suite.js"
  }
}
